# Keep this .gitignore file when building user FlexRIO release
# githubvisible=true
# All objects folders should be ignored
objects/
# Ignore things modelsim creates
modelsim/
transcript
# Ignore Python bytecode cache files
__pycache__/
# Ignore Python virtual environment
.venv/
.Xil/
# Ignore LabVIEW local project settings (machine-specific, never check in)
*.aliases
*.lvlps
# Ignore LabVIEW per-VI UserState folders (machine-specific, never check in)
*.UserState/
# Ignore temporary MS Office files
~*.xlsx
~*.pptx
~*.docx
~*.tmp
deps/
objects_old/
# Ignore generated FPGA bitfiles (never check in compiled bitstreams)
FPGA Bitfiles/
*.lvbitx